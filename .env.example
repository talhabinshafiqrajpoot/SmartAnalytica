# Copy to plagiarism_detector/.env and fill in.
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Code required to register as a teacher. Without it, anyone visiting the
# public registration page could grant themselves access to every course,
# submission and plagiarism report. Issue it only to real staff, and change
# it before any real deployment.
# Leave it empty to disable teacher self-registration entirely.
TEACHER_ACCESS_CODE=GCU-TEACHER-2024

# Optional: only needed if you re-enable the MongoDB document store.
# MONGO_URI=
